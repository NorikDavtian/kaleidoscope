# S3-compatible storage. Works with AWS S3, Cloudflare R2, MinIO, Backblaze B2.
S3_REGION=us-east-1
S3_BUCKET=kaleidoscope
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Set for non-AWS providers, e.g. https://<account>.r2.cloudflarestorage.com
S3_ENDPOINT=
# Needed by MinIO and some self-hosted gateways
S3_FORCE_PATH_STYLE=false
# Public base URL objects are served from, if different from the endpoint
S3_PUBLIC_BASE_URL=
